  "methods": {
    "uncertainty": "Pointwise two-sided95% Student-t interval on mean(Fusion\u2212fixed LiDAR), df4; sample SD across5 seeds, t*SD/sqrt5.",
    "assumptions": "Approximate independent, identically distributed, roughly normal run-level margins across5 calibration seeds on this fixed validation population; each run also contains residual execution variability that is not separately identified. LiDAR and Clean references treated as fixed; model execution variability and data-population uncertainty not estimated.",
    "limitations": "n=5; no6019-frame pseudo-replication; intervals not simultaneous/multiplicity-corrected. Seed frequencies descriptive, not calibrated probabilities. Same seed is paired across sigma by the frozen perturbation design. Clean sigma0 is one run, not five.",
    "interpolation": "Piecewise linear only for adjacent observed margins bracketing zero. Sigma0 anchor is one accepted Clean observation; all nonzero points are five-seed means. No smoothing, monotonic constraint or extrapolation.",
    "definition": "Backfire iff Fusion metric is strictly below measured unchanged LiDAR-only. mAP and NDS treated separately.",
    "sigma_definition": "Standard deviation of the frozen camera-local rotation-vector error per axis; persistent six-camera calibration draw per condition, not per-frame random corruption."
  },
