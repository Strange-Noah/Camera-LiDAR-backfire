# Shell configuration; contains no credentials.
export NUSCENES_ROOT="${NUSCENES_ROOT:-/workspace/datasets/nuscenes}"
export NUSCENES_VERSION=v1.0-mini
export PERSISTENT_ROOT="${PERSISTENT_ROOT:-/workspace}"
export METADATA_VENV="${METADATA_VENV:-/opt/venvs/nuscenes-metadata}"
