export SMOKE_OUTPUT_DIR="${SMOKE_OUTPUT_DIR:-/workspace/results/smoke_test}"
export MPLBACKEND=Agg
export MPLCONFIGDIR="${MPLCONFIGDIR:-/workspace/cache/matplotlib}"
