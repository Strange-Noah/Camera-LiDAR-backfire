# Copy to .local/member.env in your OWN Pod-local checkout; edit before sourcing.
# This file contains no credentials. MEMBER_SLUG must be a unique safe directory name.
export MEMBER_SLUG="replace-with-your-github-login"
export NUSCENES_ROOT=/workspace/datasets/nuscenes
export PERSISTENT_ROOT=/workspace
export METADATA_VENV="$HOME/.venvs/nuscenes-metadata"
export PIP_CACHE_DIR="/workspace/cache/$MEMBER_SLUG/pip"
export MPLCONFIGDIR="/workspace/cache/$MEMBER_SLUG/matplotlib"
export ENVIRONMENT_OUTPUT_DIR="/workspace/results/$MEMBER_SLUG/environment"
export SMOKE_OUTPUT_DIR="/workspace/results/$MEMBER_SLUG/smoke_test"
# Use an explicit unique --output for EVERY audit/experiment run.
